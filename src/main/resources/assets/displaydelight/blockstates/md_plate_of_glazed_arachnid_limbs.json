{
 "multipart": [
  {
   "apply": {
    "model": "displaydelight:block/wood_support"
   },
   "when": {
    "support": "true"
   }
  },
  {
   "apply": {
    "model": "displaydelight:block/md_plate_of_glazed_arachnid_limbs"
   },
   "when": {
    "AND": [
     {
      "facing": "north"
     }
    ]
   }
  },
  {
   "apply": {
    "model": "displaydelight:block/md_plate_of_glazed_arachnid_limbs",
    "y": 180
   },
   "when": {
    "AND": [
     {
      "facing": "south"
     }
    ]
   }
  },
  {
   "apply": {
    "model": "displaydelight:block/md_plate_of_glazed_arachnid_limbs",
    "y": 270
   },
   "when": {
    "AND": [
     {
      "facing": "west"
     }
    ]
   }
  },
  {
   "apply": {
    "model": "displaydelight:block/md_plate_of_glazed_arachnid_limbs",
    "y": 90
   },
   "when": {
    "AND": [
     {
      "facing": "east"
     }
    ]
   }
  }
 ]
}